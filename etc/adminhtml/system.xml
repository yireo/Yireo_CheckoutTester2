<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="yireo" sortOrder="999" translate="label">
            <label>Yireo</label>
        </tab>
        <section id="checkouttester2" translate="label" sortOrder="342" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Yireo CheckoutTester</label>
            <tab>yireo</tab>
            <resource>Yireo_CheckoutTester2::config</resource>
            <group id="settings" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Settings</label>
                <field id="funding" type="note" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Funding</label>
                    <frontend_model>Yireo\CheckoutTester2\Config\Frontend\Funding</frontend_model>
                </field>
                <field id="enabled" type="select" translate="label" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="only_in_dev_mode" type="select" translate="label" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Only in Developer Mode</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="order_id" translate="label" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sales Order ID</label>
                    <depends>
                        <field id="checkouttester2/settings/enabled">1</field>
                    </depends>
                    <comment><![CDATA[Numerical ID of sales-order entity. If zero, the latest order of the current store view is picked. Orders of other store views are never shown.]]></comment>
                </field>
                <field id="ip" translate="label comment" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Development IP</label>
                    <depends>
                        <field id="checkouttester2/settings/enabled">1</field>
                    </depends>
                    <backend_model>Yireo\CheckoutTester2\Config\Backend\IpList</backend_model>
                    <comment><![CDATA[CSV-list of IP-addresses allowed access. Use * to allow all IPs, but only in developer mode (and only when "Only in Developer Mode" is enabled). If empty, all IPs are allowed in developer mode only. The IP of the connection is used, unless it comes from a trusted proxy.]]></comment>
                </field>
                <field id="trusted_proxies" translate="label" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Trusted Proxies</label>
                    <depends>
                        <field id="checkouttester2/settings/enabled">1</field>
                    </depends>
                    <comment><![CDATA[CSV-list of IP-addresses of your own reverse proxies (like Varnish or a load balancer). Only for connections from these IPs, the X-Forwarded-For header is used to determine the visitor IP. Never add IPs that you do not control.]]></comment>
                </field>
                <field id="checkout_onepage_controller_success_action" type="select" translate="label" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Generate event</label>
                    <depends>
                        <field id="checkouttester2/settings/enabled">1</field>
                    </depends>
                    <comment><![CDATA[Event "checkout_onepage_controller_success_action" is triggered with every page view. Warning: this may send conversions to analytics or trigger other order processing again.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="usage" type="select" translate="label" sortOrder="4" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Usage</label>
                    <depends>
                        <field id="checkouttester2/settings/enabled">1</field>
                    </depends>
                    <frontend_model>Yireo\CheckoutTester2\Block\Field\Link</frontend_model>
                </field>
            </group>
        </section>
    </system>
</config>
